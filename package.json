{
  "name": "dtrgame",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "audit:legacy": "node scripts/audit-legacy.mjs ../legacy-dts docs/legacy-source-manifest.json",
    "generate:legacy": "node scripts/generate-legacy-registry.mjs ../legacy-dts src/generated/legacy-registry.ts",
    "generate:items": "node scripts/generate-legacy-starting-items.mjs ../legacy-dts src/generated/legacy-starting-items.ts",
    "generate:recipes": "node scripts/generate-legacy-recipes.mjs ../legacy-dts src/generated/legacy-recipes.ts",
    "generate:special-recipes": "node scripts/generate-legacy-special-recipes.mjs ../legacy-dts src/generated/legacy-special-recipes.ts",
    "generate:hooks": "node scripts/generate-legacy-hook-manifest.mjs ../legacy-dts src/generated/legacy-hook-manifest.ts",
    "generate:rooms": "node scripts/generate-legacy-room-types.mjs ../legacy-dts src/generated/legacy-room-types.ts",
    "test:php-parity": "node scripts/run-php-parity.mjs",
    "golden:up": "tools/golden-tunnel up",
    "golden:down": "tools/golden-tunnel down",
    "capture:golden": "node scripts/capture-golden.mjs",
    "generate:migration": "node scripts/generate-legacy-module-migration.mjs ../legacy-dts docs/legacy-module-migration.json",
    "verify": "npm run check && npm test && npm run build",
    "deploy": "wrangler deploy"
  },
  "engines": { "node": ">=22.0.0" },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261028.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.154.0"
  }
}
